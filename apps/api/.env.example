DATABASE_URL="postgresql://brewlite:brewlite_password@localhost:5432/brewlite_db?schema=public"
JWT_SECRET="brewlite_super_secret_jwt_key_2026"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# --- Thanh toán ---
# "mock": giả lập (dùng cho test/CI). "vnpay": thanh toán thật qua VNPay Sandbox (quét QR / thẻ test).
PAYMENT_PROVIDER=vnpay
VNPAY_TMN_CODE="dien_tmn_code_sandbox_cua_nhom"
VNPAY_HASH_SECRET="dien_hash_secret_sandbox_cua_nhom"
# Origin công khai của backend (VNPay và điện thoại phải truy cập được). Chạy local một máy: http://localhost:4000.
# Muốn điện thoại/VNPay gọi về được: dùng tunnel, ví dụ `ngrok http 4000`, rồi dán https://xxxx.ngrok-free.app vào đây.
API_PUBLIC_URL="http://localhost:4000"
VNPAY_QR_TTL_MINUTES=10
